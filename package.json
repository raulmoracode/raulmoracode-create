{
  "name": "@raulmoracode/create",
  "version": "1.0.3",
  "description": "Professional CLI to scaffold React + Vite and Next.js projects with Tailwind CSS, shadcn, Biome and Vitest.",
  "keywords": [
    "raulmoracode",
    "scaffold",
    "scaffolder",
    "cli",
    "react",
    "vite",
    "nextjs",
    "tailwindcss",
    "shadcn",
    "biome",
    "vitest",
    "pnpm"
  ],
  "homepage": "https://github.com/raulmoracode/raulmoracode-create#readme",
  "bugs": {
    "url": "https://github.com/raulmoracode/raulmoracode-create/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raulmoracode/raulmoracode-create.git"
  },
  "license": "MIT",
  "author": "raulmoracode",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "raulmoracode-create": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
